# ==============================================================================
# SPARKLEHOME & TRAVEL ECOSYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and provide your actual local environment values.
# NEVER commit the actual .env file or real secrets to GitHub!
# ==============================================================================

# Server Port
SERVER_PORT=8080

# MySQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/home_service_booking?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=your_database_username
SPRING_DATASOURCE_PASSWORD=your_database_password
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# Spring Security & JWT Configuration
APP_JWT_SECRET=YourSuperSecretJwtSigningKeyAtLeast256BitsLongForHMACSHA256EnterpriseSecurity2026
APP_JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins
APP_CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://localhost:8080

# Default Seed Administrator Credentials
APP_ADMIN_EMAIL=admin@sparklehome.com
APP_ADMIN_PASSWORD=YourSecureAdminPassword123!
